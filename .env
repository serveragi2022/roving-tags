# Copy this file to ".env" and fill in your values.
# Server address WITH /api at the end (login, accounts and uploads use it).
# Leave it empty to run uploads in DEMO MODE (login and account sync always need the server).
EXPO_PUBLIC_API_URL=http://192.168.101.66:8180/api
# Branch name used to sync the accounts (GET /api/user?branch=...)
EXPO_PUBLIC_BRANCH=Calamba
