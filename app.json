{
  "expo": {
    "name": "Roving Tags",
    "slug": "roving-tags",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Roving Tags needs the camera to scan machine QR codes and take inspection photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Roving Tags stamps the photo with your location."
        }
      ]
    ]
  }
}
